{
  "name": "peopleflow-react",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Employee onboarding and offboarding workspace built with React and JavaScript.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1",
    "build": "vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 127.0.0.1",
    "test": "npm run test:domain && npm run test:react",
    "test:domain": "node --test tests/domain.test.js",
    "test:react": "vitest run --configLoader native",
    "test:watch": "vitest --configLoader native",
    "check": "npm test && npm run build",
    "format:check": "prettier --check src tests index.html vite.config.js package.json",
    "format": "prettier --write src tests index.html vite.config.js package.json"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2"
  }
}
